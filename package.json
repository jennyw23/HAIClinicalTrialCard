{
  "name": "ai-clinical-trial-cards",
  "version": "1.0.0",
  "description": "Website for AI Clinical Trial Cards - Standardizing Human-AI Collaboration Research",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:import": "node db/import-csv.js",
    "db:import:update": "node db/import-csv.js --update",
    "db:import:dry": "node db/import-csv.js --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@neondatabase/serverless": "^1.1.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "vercel": "^54.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
